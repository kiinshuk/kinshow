{
  "regions": ["sin1"],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Link", "value": "</llms.txt>; rel=\"llms.txt\"" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/blog/:slug*", "destination": "/blog/_not-found" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
